{
    "name": "discord-ollama-bot",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "index.ts",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "node dev-runner.ts",
        "start": "node index.ts",
        "test": "LOG_LEVEL=silent node --test",
        "typecheck": "tsc --noEmit",
        "lint": "biome check --error-on-warnings .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "check": "npm run lint && npm run typecheck && npm test"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@types/node": "26.4.0",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "@discordjs/rest": "^2.6.3",
        "@tavily/core": "^0.7.8",
        "discord-api-types": "^0.38.53",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "js-yaml": "^5.4.0",
        "node-fetch": "^3.3.2"
    }
}
